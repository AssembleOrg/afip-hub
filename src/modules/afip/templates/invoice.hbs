<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #000; }
  body { padding: 0; }

  .doc { width: 100%; }

  /* Cada bloque comparte borde para que se vea como un formulario continuo */
  .box { border: 1px solid #000; }

  /* === "ORIGINAL" === */
  .original {
    text-align: center; font-weight: bold; font-size: 13px;
    padding: 4px 0; border: 1px solid #000; border-bottom: none;
  }

  /* === ENCABEZADO === */
  /* 3 columnas reales: emisor | letra | comprobante. La columna de la letra va
     centrada con líneas divisorias a ambos lados (como el comprobante oficial),
     y al ser una columna propia NUNCA se superpone con el título. */
  .header { display: flex; border: 1px solid #000; min-height: 118px; }
  .header-left { flex: 1; padding: 8px 12px; border-right: 1px solid #000; }
  .header-letra {
    width: 64px; flex-shrink: 0; padding: 6px 0;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    border-right: 1px solid #000;
  }
  .header-right { flex: 1; padding: 8px 12px; }

  .emisor-nombre {
    text-align: center; font-weight: bold; font-size: 13px;
    margin: 6px 0 14px;
  }
  .ln { font-size: 10px; line-height: 1.5; margin-bottom: 2px; }
  .ln b { font-weight: bold; }

  .header-letra .letra { font-size: 34px; font-weight: bold; line-height: 1; margin-top: 4px; }
  .header-letra .cod { font-size: 8px; margin-top: 2px; }

  .header-right .titulo { font-size: 22px; font-weight: bold; margin: 2px 0 22px; }
  .header-right .ln { margin-bottom: 3px; }

  /* === PERÍODO === */
  .periodo {
    border: 1px solid #000; border-top: none;
    padding: 5px 12px; font-size: 10px; font-weight: bold;
    display: flex; flex-wrap: wrap; gap: 6px 34px;
  }
  .periodo .lbl { font-weight: bold; }
  .periodo .val { font-weight: bold; }

  /* === RECEPTOR === */
  .receptor {
    border: 1px solid #000; border-top: none;
    padding: 8px 12px; font-size: 10px; line-height: 1.7;
  }
  .receptor .row { display: flex; }
  .receptor .row > div { flex: 1; }
  .receptor b { font-weight: bold; }

  /* === TABLA DE ITEMS === */
  .items { width: 100%; border-collapse: collapse; margin-top: 8px; table-layout: fixed; }
  .items th {
    background: #e6e6e6; border: 1px solid #000; padding: 5px 4px;
    font-size: 9.5px; font-weight: bold; text-align: center;
  }
  .items td { padding: 5px 5px; font-size: 9.5px; vertical-align: top; }
  .items tbody td { border-left: 1px solid #000; border-right: 1px solid #000; }
  .items .r { text-align: right; }
  .items .c { text-align: center; }
  /* filas superior/inferior del cuerpo cerradas por líneas del encabezado y el pie */
  .items thead tr th { border-bottom: 1px solid #000; }

  .items-wrap { border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000; }

  /* === TOTALES === */
  .totales { display: flex; justify-content: flex-end; margin-top: 10px; }
  .totales .caja { width: 340px; border: 1px solid #000; padding: 8px 12px; }
  .totales .fila { display: flex; justify-content: space-between; font-size: 11px; font-weight: bold; padding: 3px 0; }
  .totales .fila.grande { font-size: 13px; }

  /* === PIE: QR + ARCA + CAE === */
  .pie { display: flex; align-items: flex-start; margin-top: 16px; }
  .pie-qr { width: 120px; }
  .pie-qr img { width: 108px; height: 108px; display: block; }
  .pie-logo { width: 190px; padding-top: 6px; }
  .arca { font-size: 30px; font-weight: bold; letter-spacing: 1px; line-height: 1; }
  .arca-sub { font-size: 6.5px; font-weight: bold; letter-spacing: 0.3px; margin-top: 2px; }
  .pie-mid { flex: 1; text-align: center; padding-top: 6px; }
  .pie-mid .pag { font-size: 11px; font-weight: bold; }
  .pie-mid .autorizado { font-size: 12px; font-weight: bold; font-style: italic; margin-top: 30px; }
  .pie-mid .legal { font-size: 7.5px; margin-top: 3px; }
  .pie-right { width: 250px; text-align: right; padding-top: 6px; }
  .pie-right .cae { font-size: 12px; font-weight: bold; margin-bottom: 4px; }
  .pie-right .cae b { font-weight: bold; }
</style>
</head>
<body>
<div class="doc">

  <div class="original">ORIGINAL</div>

  <!-- ENCABEZADO -->
  <div class="header">
    <div class="header-left">
      <div class="emisor-nombre">{{emisor.razonSocial}}</div>
      <div class="ln"><b>Razón Social:</b> {{emisor.razonSocial}}</div>
      {{#if emisor.domicilio}}<div class="ln"><b>Domicilio Comercial:</b> {{emisor.domicilio}}</div>{{/if}}
      <div class="ln"><b>Condición frente al IVA:</b> {{emisor.condicionIva}}</div>
    </div>

    <div class="header-letra">
      <div class="letra">{{letra}}</div>
      <div class="cod">COD. {{codigoComprobante}}</div>
    </div>

    <div class="header-right">
      <div class="titulo">{{tipoComprobanteTitulo}}</div>
      <div class="ln"><b>Punto de Venta:</b> {{puntoVentaStr}} &nbsp;&nbsp;&nbsp; <b>Comp. Nro:</b> {{numeroComprobanteStr}}</div>
      <div class="ln"><b>Fecha de Emisión:</b> {{fechaEmision}}</div>
      <div class="ln" style="margin-top:6px;"><b>CUIT:</b> {{emisor.cuit}}</div>
      {{#if emisor.iibb}}<div class="ln"><b>Ingresos Brutos:</b> {{emisor.iibb}}</div>{{/if}}
      {{#if emisor.inicioActividades}}<div class="ln"><b>Fecha de Inicio de Actividades:</b> {{emisor.inicioActividades}}</div>{{/if}}
    </div>
  </div>

  <!-- PERÍODO -->
  <div class="periodo">
    <span><span class="lbl">Período Facturado Desde:</span> <span class="val">{{#if periodoDesde}}{{periodoDesde}}{{else}}{{fechaEmision}}{{/if}}</span></span>
    <span><span class="lbl">Hasta:</span> <span class="val">{{#if periodoHasta}}{{periodoHasta}}{{else}}{{fechaEmision}}{{/if}}</span></span>
    <span><span class="lbl">Fecha de Vto. para el pago:</span> <span class="val">{{#if fechaVencimientoPago}}{{fechaVencimientoPago}}{{else}}{{fechaEmision}}{{/if}}</span></span>
  </div>

  <!-- RECEPTOR -->
  <div class="receptor">
    <div class="row">
      <div><b>CUIT:</b> {{receptor.documentoFormateado}}</div>
      <div><b>Apellido y Nombre / Razón Social:</b> {{receptor.razonSocial}}</div>
    </div>
    <div class="row">
      <div><b>Condición frente al IVA:</b> {{receptor.condicionIva}}</div>
      {{#if receptor.domicilio}}<div><b>Domicilio:</b> {{receptor.domicilio}}</div>{{else}}<div></div>{{/if}}
    </div>
    <div class="row">
      <div><b>Condición de venta:</b> {{#if condicionVenta}}{{condicionVenta}}{{else}}Contado{{/if}}</div>
    </div>
  </div>

  <!-- DETALLE -->
  <table class="items">
    <thead>
      <tr>
        <th style="width:8%">Código</th>
        <th style="width:34%">Producto / Servicio</th>
        <th style="width:9%">Cantidad</th>
        <th style="width:9%">U. Medida</th>
        <th style="width:12%">Precio Unit.</th>
        <th style="width:7%">% Bonif.</th>
        <th style="width:9%">Imp. Bonif.</th>
        <th style="width:12%">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td class="c">{{this.codigo}}</td>
        <td>{{this.descripcion}}</td>
        <td class="c">{{this.cantidadStr}}</td>
        <td class="c">{{this.unidadStr}}</td>
        <td class="r">{{this.precioUnitarioStr}}</td>
        <td class="c">{{this.bonificacionStr}}</td>
        <td class="r">{{this.impBonificadoStr}}</td>
        <td class="r">{{this.subtotalStr}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- TOTALES -->
  <div class="totales">
    <div class="caja">
      {{#if isFacturaA}}
      <div class="fila"><span>Importe Neto Gravado: $</span><span>{{importeNetoGravadoStr}}</span></div>
      {{#if importeIvaStr}}<div class="fila"><span>IVA: $</span><span>{{importeIvaStr}}</span></div>{{/if}}
      {{else}}
      <div class="fila"><span>Subtotal: $</span><span>{{subtotalGeneralStr}}</span></div>
      {{/if}}
      <div class="fila"><span>Importe Otros Tributos: $</span><span>{{#if importeTributosStr}}{{importeTributosStr}}{{else}}0,00{{/if}}</span></div>
      <div class="fila grande"><span>Importe Total: $</span><span>{{importeTotalStr}}</span></div>
    </div>
  </div>

  <!-- PIE -->
  <div class="pie">
    <div class="pie-qr"><img src="{{qrDataUrl}}" alt="QR AFIP" /></div>
    <div class="pie-logo">
      <div class="arca">ARCA</div>
      <div class="arca-sub">AGENCIA DE RECAUDACIÓN<br>Y CONTROL ADUANERO</div>
    </div>
    <div class="pie-mid">
      <div class="pag">Pág. 1/1</div>
      <div class="autorizado">Comprobante Autorizado</div>
      <div class="legal">Esta Agencia no se responsabiliza por los datos ingresados en el detalle de la operación</div>
    </div>
    <div class="pie-right">
      <div class="cae"><b>CAE N°:</b> {{cae}}</div>
      <div class="cae"><b>Fecha de Vto. de CAE:</b> {{caeFechaVencimiento}}</div>
    </div>
  </div>

</div>
</body>
</html>
